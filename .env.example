# Example environment variables
# Frontend: NEXT_PUBLIC_* variables are exposed to the browser and must be set in your deployment platform

# Backend URL for the external yt-dlp service (e.g., your Render.com deployment)
# This should be the public URL of your Render backend
NEXT_PUBLIC_YTDLP_BACKEND_URL=https://vidgrab-server.onrender.com

# Server-side only (not used in pure client-side mode, kept for reference)
# DATABASE_URL (optional) — Postgres connection string for logging; leave empty if you don't need logging
# DATABASE_URL=
# PORT=5000
# NODE_ENV=production
